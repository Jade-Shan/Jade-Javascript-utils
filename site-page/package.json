		"./workout-pose": {
			"types": "./dist/workout/workoutPoseData.d.ts",
			"default": "./dist/workout/workoutPoseData.js"
		},
		"./test-jade-utils": {
			"types": "./dist/testJadeUtils.d.ts",
			"default": "./dist/testJadeUtils.js"
		},
		"./test-jade-ui": {
			"types": "./dist/ui/testJadeUI.d.ts",
			"default": "./dist/ui/testJadeUI.js"
		},
		"./test-jade-trpg": {
			"types": "./dist/trpg/testJadeTRPG.d.ts",
