{
	"name": "@jade-dungeon/site-page",
	"version": "3.0.0",
	"description": "jade-dungeon 的站点：博客 / 相册 / Wiki / TRPG 沙盘 / 健身肌肉图页面",
	"license": "GPL-3.0-or-later",
	"author": "Jade Shan",
	"private": true,
	"sideEffects": false,
	"dependencies": {
		"@jade-dungeon/jade-utils": "*"
	},
	"exports": {
		"./3rd-lib-tool": {
			"types": "./dist/3rdLibTool.d.ts",
			"default": "./dist/3rdLibTool.js"
		},
		"./sandtable": {
			"types": "./dist/trpg/sandtable.d.ts",
			"default": "./dist/trpg/sandtable.js"
		},
		"./sandbox-api": {
			"types": "./dist/sandbox/sandboxApi.d.ts",
			"default": "./dist/sandbox/sandboxApi.js"
		},
		"./sandbox-scene": {
			"types": "./dist/sandbox/sandboxScene.d.ts",
			"default": "./dist/sandbox/sandboxScene.js"
		},
		"./sandbox-windows": {
			"types": "./dist/sandbox/sandboxWindows.d.ts",
			"default": "./dist/sandbox/sandboxWindows.js"
		},
		"./sandbox-view": {
			"types": "./dist/sandbox/sandboxView.d.ts",
			"default": "./dist/sandbox/sandboxView.js"
		},
		"./blog-comm": {
			"types": "./dist/blog/common.d.ts",
			"default": "./dist/blog/common.js"
		},
		"./blog": {
			"types": "./dist/blog/blog.d.ts",
			"default": "./dist/blog/blog.js"
		},
		"./gallery": {
			"types": "./dist/blog/gallery.d.ts",
