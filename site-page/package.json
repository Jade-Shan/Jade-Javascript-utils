		},
		"./test-workout": {
			"types": "./dist/workout/testWorkout.d.ts",
			"default": "./dist/workout/testWorkout.js"
		},
		"./site-config": {
			"types": "./dist/site.config.d.ts",
			"default": "./dist/site.config.js"
		}
	},
	"scripts": {
		"build": "gulp compress-typescript",
		"build:test": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('.test-build/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
		"test": "npm run build:test && node --test \".test-build/src/test/ts/**/*.test.js\""
	}
}
